<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         CLIENT ACTION  →  registers the OWL component as a navigable page
         ══════════════════════════════════════════════════════════════════ -->
    <record id="action_attendance_dashboard" model="ir.actions.client">
        <field name="name">Attendance Dashboard</field>
        <field name="tag">attendance_dashboard_action</field>
    </record>


    <!-- ══════════════════════════════════════════════════════════════════
         CUSTOM LIST VIEW  —  hr.attendance (present drilldown)
         Shows employee, department, check-in, check-out, worked hours
         ══════════════════════════════════════════════════════════════════ -->
    <record id="view_hr_attendance_dashboard_list" model="ir.ui.view">
        <field name="name">hr.attendance.dashboard.list</field>
        <field name="model">hr.attendance</field>
        <field name="priority">22</field>
        <field name="arch" type="xml">
            <list string="Present Employees"
                  create="false"
                  delete="false"
                  default_order="check_in desc">
                <field name="employee_id"   string="Employee"/>
                <field name="department_id" string="Department"/>
                <field name="check_in"      string="Check In"/>
                <field name="check_out"     string="Check Out"/>
                <field name="worked_hours"  string="Worked Hours"
                       widget="float_time"/>
            </list>
        </field>
    </record>


    <!-- ══════════════════════════════════════════════════════════════════
         CUSTOM LIST VIEW  —  hr.employee (absent / on-leave drilldown)
         Shows name, department, job position, mobile
         ══════════════════════════════════════════════════════════════════ -->
    <record id="view_hr_employee_dashboard_list" model="ir.ui.view">
        <field name="name">hr.employee.dashboard.list</field>
        <field name="model">hr.employee</field>
        <field name="priority">22</field>
        <field name="arch" type="xml">
            <list string="Employees"
                  create="false"
                  delete="false"
                  default_order="department_id, name">
                <field name="name"          string="Employee"/>
                <field name="department_id" string="Department"/>
                <field name="job_id"        string="Job Position"/>
                <field name="work_phone"    string="Work Phone"   optional="show"/>
                <field name="mobile_phone"  string="Mobile"       optional="show"/>
            </list>
        </field>
    </record>


    <!-- ══════════════════════════════════════════════════════════════════
         MENU STRUCTURE
         ══════════════════════════════════════════════════════════════════ -->

    <!-- Top-level "Attendance" app menu already exists from hr_attendance.
         We add our dashboard as a sub-menu under it.  If you want the
         dashboard to be the first item the user sees when opening the
         Attendance app, set sequence="1". -->

      <menuitem
        id="menu_attendance_dashboard_root"
        name="Attendance Dashboard"
        action="action_attendance_dashboard"
        sequence="15"
    />

</odoo>
