<odoo>
    <record id="module_category_backup" model="ir.module.category">
        <field name="name">Database Backup Pro</field>
        <field name="sequence">20</field>
    </record>

    <record id="groups_privilege_backup" model="res.groups.privilege">
        <field name="name">Backup Manager</field>
        <field name="category_id" ref="module_category_backup"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_backup_manager" model="res.groups">
        <field name="name">Backup Manager</field>
        <field name="privilege_id" ref="groups_privilege_backup"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="rule_backup_config_company" model="ir.rule">
        <field name="name">Backup configurations by company</field>
        <field name="model_id" ref="model_db_backup_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_backup_manager'))]"/>
    </record>

    <record id="rule_backup_history_company" model="ir.rule">
        <field name="name">Backup history by company</field>
        <field name="model_id" ref="model_db_backup_history"/>
        <field name="domain_force">[('config_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_backup_manager'))]"/>
    </record>
</odoo>
