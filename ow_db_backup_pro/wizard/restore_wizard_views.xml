<odoo>
    <record id="view_db_backup_restore_wizard_form" model="ir.ui.view">
        <field name="name">db.backup.restore.wizard.form</field>
        <field name="model">db.backup.restore.wizard</field>
        <field name="arch" type="xml">
            <form string="Restore Database">
                <div class="alert alert-warning" role="alert">
                    This creates a brand-new database from the backup. It will never
                    overwrite an existing database. Test on a staging server first.
                </div>
                <group>
                    <field name="source" widget="radio"/>
                    <field name="history_id" invisible="source != 'history'" readonly="1"/>
                    <field name="upload_filename" invisible="1"/>
                    <field name="upload_file" filename="upload_filename" invisible="source != 'upload'"/>
                    <field name="new_database_name"/>
                </group>
                <footer>
                    <button name="action_restore" type="object" string="Restore" class="btn-danger"
                            confirm="This will create a new database. Continue?"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
