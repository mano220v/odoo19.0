<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ow_currency" model="ir.module.category">
        <field name="name">Live Currency Rate Updater</field>
        <field name="sequence">25</field>
    </record>

    <record id="privilege_ow_currency" model="res.groups.privilege">
        <field name="name">Currency Rate Updater Access</field>
        <field name="category_id" ref="module_category_ow_currency"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_ow_currency_user" model="res.groups">
        <field name="name">User: View Dashboard</field>
        <field name="privilege_id" ref="privilege_ow_currency"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_ow_currency_manager" model="res.groups">
        <field name="name">Manager: Configure &amp; Sync</field>
        <field name="privilege_id" ref="privilege_ow_currency"/>
        <field name="implied_ids" eval="[(4, ref('group_ow_currency_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
