<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ow_sticky_note_list" model="ir.ui.view">
        <field name="name">ow.sticky.note.list</field>
        <field name="model">ow.sticky.note</field>
        <field name="arch" type="xml">
            <list string="Sticky Notes">
                <field name="name"/>
                <field name="color"/>
                <field name="is_pinned"/>
                <field name="user_id"/>
                <field name="res_model"/>
                <field name="res_name"/>
                <field name="write_date"/>
            </list>
        </field>
    </record>

    <record id="view_ow_sticky_note_form" model="ir.ui.view">
        <field name="name">ow.sticky.note.form</field>
        <field name="model">ow.sticky.note</field>
        <field name="arch" type="xml">
            <form string="Sticky Note">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color"/>
                        <field name="is_pinned"/>
                        <field name="user_id"/>
                    </group>
                    <group string="Linked Record" invisible="not res_model">
                        <field name="res_model"/>
                        <field name="res_id"/>
                        <field name="res_name"/>
                    </group>
                    <field name="content" placeholder="Note content..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ow_sticky_note" model="ir.actions.act_window">
        <field name="name">Sticky Notes</field>
        <field name="res_model">ow.sticky.note</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_user_id': uid}</field>
    </record>

    <!-- Fallback / admin entry point under Settings > Technical.
         Everyday use is via the floating widget, not this menu. -->
    <menuitem id="menu_ow_sticky_note"
              name="Sticky Notes"
              action="action_ow_sticky_note"
              parent="base.next_id_9"
              groups="base.group_no_one"
              sequence="100"/>

</odoo>
