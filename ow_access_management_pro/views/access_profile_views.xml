<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_access_profile_list" model="ir.ui.view"><field name="name">ow.access.profile.list</field><field name="model">ow.access.profile</field><field name="arch" type="xml"><list decoration-muted="not active" decoration-success="state == 'applied'"><field name="sequence" widget="handle"/><field name="name"/><field name="state" widget="badge" decoration-success="state == 'applied'" decoration-info="state == 'draft'"/><field name="user_count"/><field name="permission_count"/><field name="rule_count"/><field name="field_policy_count"/><field name="last_applied_at"/><field name="active" column_invisible="True"/><button name="action_apply" type="object" string="Apply" icon="fa-shield" class="btn-primary"/></list></field></record>
 <record id="view_access_profile_kanban" model="ir.ui.view"><field name="name">ow.access.profile.kanban</field><field name="model">ow.access.profile</field><field name="arch" type="xml"><kanban class="ow_access_kanban"><field name="name"/><field name="state"/><field name="color"/><field name="user_count"/><field name="permission_count"/><field name="rule_count"/><field name="field_policy_count"/><templates><t t-name="card"><div class="ow_access_card"><div class="ow_access_card_top"><span class="ow_access_icon"><i class="fa fa-shield" title="Access profile"/></span><span class="badge rounded-pill" t-att-class="record.state.raw_value === 'applied' ? 'text-bg-success' : 'text-bg-light'"><field name="state"/></span></div><h3><field name="name"/></h3><div class="ow_access_stats"><span><b><field name="user_count"/></b> Users</span><span><b><field name="permission_count"/></b> Models</span><span><b><field name="rule_count"/></b> Rules</span><span><b><field name="field_policy_count"/></b> Fields</span></div><button name="action_apply" type="object" class="btn btn-primary w-100 mt-3"><i class="fa fa-bolt me-1"/> Apply Profile</button></div></t></templates></kanban></field></record>
 <record id="view_access_profile_form" model="ir.ui.view"><field name="name">ow.access.profile.form</field><field name="model">ow.access.profile</field><field name="arch" type="xml"><form string="Access Profile" class="ow_access_form"><header><button name="action_apply" type="object" string="Apply Security Profile" icon="fa-shield" class="btn-primary"/><button name="action_reset_draft" type="object" string="Set to Draft" invisible="state == 'draft'"/><button name="action_duplicate" type="object" string="Duplicate"/><field name="state" widget="statusbar" statusbar_visible="draft,applied"/></header><sheet><div class="oe_button_box" name="button_box"><button name="action_view_users" type="object" class="oe_stat_button" icon="fa-users"><field name="user_count" widget="statinfo" string="Users"/></button></div><widget name="web_ribbon" title="Inactive" bg_color="text-bg-danger" invisible="active"/><div class="ow_access_hero"><div class="ow_access_hero_icon"><i class="fa fa-lock" title="Secure access"/></div><div><h2>Access policy workspace</h2><p>Bundle users, groups, permissions, record domains, menus and field behavior in one reusable profile.</p></div></div><div class="oe_title"><label for="name"/><h1><field name="name" placeholder="Example: Sales Team — Limited"/></h1></div><group><group><field name="active"/><field name="user_ids" widget="many2many_tags" options="{'no_create': True}"/><field name="implied_group_ids" widget="many2many_tags" options="{'no_create': True}"/></group><group><field name="generated_group_id" options="{'no_create': True}"/><field name="last_applied_at"/><field name="last_applied_by"/></group></group><field name="description" placeholder="Explain who should use this profile and what it grants..."/><notebook><page string="Model Permissions" name="permissions"><field name="access_line_ids"><list editable="bottom"><field name="model_id" options="{'no_create': True}"/><field name="model_name" column_invisible="True"/><field name="perm_read"/><field name="perm_write"/><field name="perm_create"/><field name="perm_unlink"/><field name="native_access_id" column_invisible="True"/></list></field><div class="alert alert-info mt-3" role="status">Permissions grant access through the generated security group. Existing Odoo groups can also grant access.</div></page><page string="Record Rules" name="rules"><field name="rule_line_ids"><list editable="bottom"><field name="name"/><field name="model_id" options="{'no_create': True}"/><field name="domain_force"/><field name="perm_read"/><field name="perm_write"/><field name="perm_create"/><field name="perm_unlink"/></list></field></page><page string="Menus" name="menus"><div class="ow_access_hint"><i class="fa fa-eye-slash" title="Hidden menus"/><div><b>Hide menus and all their children</b><span>Selected menus disappear for users assigned to this applied profile.</span></div></div><field name="hidden_menu_ids" widget="many2many_tags" options="{'no_create': True}"/></page><page string="Field UI Policies" name="fields"><field name="field_line_ids"><list editable="bottom"><field name="model_id" options="{'no_create': True}"/><field name="field_id" options="{'no_create': True}"/><field name="policy"/></list></field><div class="alert alert-warning mt-3" role="status">Field policies control standard Odoo views. Use model permissions and record rules for server-side data security.</div></page><page string="Chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></page></notebook></sheet></form></field></record>
 <record id="view_access_profile_search" model="ir.ui.view"><field name="name">ow.access.profile.search</field><field name="model">ow.access.profile</field><field name="arch" type="xml"><search><field name="name"/><field name="user_ids"/><filter name="applied" string="Applied" domain="[('state','=','applied')]"/><filter name="draft" string="Draft" domain="[('state','=','draft')]"/><filter name="inactive" string="Inactive" domain="[('active','=',False)]"/></search></field></record>
 <record id="action_access_profile" model="ir.actions.act_window"><field name="name">Access Profiles</field><field name="res_model">ow.access.profile</field><field name="view_mode">kanban,list,form</field><field name="search_view_id" ref="view_access_profile_search"/><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Create your first access profile</p><p>Build reusable roles and apply them to users in one click.</p></field></record>
</odoo>
