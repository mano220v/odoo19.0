<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_woo_product_mapping_list" model="ir.ui.view">
        <field name="name">woo.product.mapping.list</field>
        <field name="model">woo.product.mapping</field>
        <field name="arch" type="xml">
            <list string="Product Mappings">
                <field name="instance_id"/>
                <field name="woo_id"/>
                <field name="sku"/>
                <field name="product_tmpl_id"/>
                <field name="last_sync_date"/>
            </list>
        </field>
    </record>

    <record id="view_woo_product_mapping_form" model="ir.ui.view">
        <field name="name">woo.product.mapping.form</field>
        <field name="model">woo.product.mapping</field>
        <field name="arch" type="xml">
            <form string="Product Mapping">
                <sheet>
                    <group>
                        <field name="instance_id"/>
                        <field name="woo_id"/>
                        <field name="sku"/>
                        <field name="product_tmpl_id"/>
                        <field name="last_sync_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_woo_product_mapping" model="ir.actions.act_window">
        <field name="name">Product Mappings</field>
        <field name="res_model">woo.product.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

