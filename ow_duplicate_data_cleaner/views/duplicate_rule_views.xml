<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_duplicate_rule_list" model="ir.ui.view"><field name="name">ow.duplicate.rule.list</field><field name="model">ow.duplicate.rule</field><field name="arch" type="xml"><list decoration-muted="not active"><field name="sequence" widget="handle"/><field name="name"/><field name="model_id"/><field name="minimum_confidence" widget="progressbar"/><field name="open_group_count"/><field name="duplicate_record_count"/><field name="last_scan_at"/><field name="scheduled_scan" widget="boolean_toggle"/><field name="active" column_invisible="True"/><button name="action_scan_now" type="object" string="Scan" icon="fa-search" class="btn-primary"/></list></field></record>
 <record id="view_duplicate_rule_form" model="ir.ui.view"><field name="name">ow.duplicate.rule.form</field><field name="model">ow.duplicate.rule</field><field name="arch" type="xml"><form string="Duplicate Detection Rule" class="ow_cleaner_form"><header><button name="action_scan_now" type="object" string="Scan Now" icon="fa-search" class="btn-primary"/><field name="active" widget="boolean_toggle"/></header><sheet><div class="oe_button_box" name="button_box"><button name="action_view_scans" type="object" class="oe_stat_button" icon="fa-history"><field name="scan_count" widget="statinfo" string="Scans"/></button><button name="action_view_scans" type="object" class="oe_stat_button" icon="fa-clone"><field name="open_group_count" widget="statinfo" string="To Review"/></button></div><div class="ow_cleaner_hero"><div class="ow_cleaner_hero_icon"><i class="fa fa-magic" title="Detection rule"/></div><div><h2>Smart duplicate detection</h2><p>Combine exact and fuzzy rules to find the records that simple searches miss.</p></div></div><widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/><div class="oe_title"><label for="name"/><h1><field name="name" placeholder="Example: Contacts by email and phone"/></h1></div><group><group string="Target"><field name="model_id" options="{'no_create': True}"/><field name="company_id" groups="base.group_multi_company"/><field name="company_scope"/><field name="domain_filter" placeholder="[('customer_rank', '&gt;', 0)]"/></group><group string="Scan controls"><field name="minimum_confidence" widget="percentage"/><field name="maximum_records"/><field name="include_archived"/><field name="scheduled_scan"/><field name="last_scan_at" readonly="1"/><field name="last_scan_state" readonly="1"/></group></group><notebook><page string="Matching Fields" name="fields"><field name="field_line_ids" context="{'default_model_id': model_id}"><list editable="bottom"><field name="sequence" widget="handle"/><field name="model_id" column_invisible="True"/><field name="field_id" options="{'no_create': True}"/><field name="match_type"/><field name="normalization"/><field name="weight"/><field name="threshold"/><field name="required_match"/></list></field><div class="alert alert-info mt-3" role="status">Higher weights make important identifiers such as VAT, email, or phone contribute more to the confidence score.</div></page><page string="Activity"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></page></notebook></sheet></form></field></record>
 <record id="view_duplicate_rule_search" model="ir.ui.view"><field name="name">ow.duplicate.rule.search</field><field name="model">ow.duplicate.rule</field><field name="arch" type="xml"><search><field name="name"/><field name="model_id"/><filter name="scheduled" string="Scheduled" domain="[('scheduled_scan','=',True)]"/><filter name="archived" string="Archived" domain="[('active','=',False)]"/><group><filter name="group_model" string="Model" context="{'group_by':'model_id'}"/></group></search></field></record>
 <record id="action_duplicate_rule" model="ir.actions.act_window"><field name="name">Detection Rules</field><field name="res_model">ow.duplicate.rule</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_duplicate_rule_search"/><field name="context">{'search_default_scheduled': 0}</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Create your first duplicate detection rule</p><p>Choose a model, add matching fields, and run a safe review scan.</p></field></record>
</odoo>
