<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_duplicate_group_list" model="ir.ui.view"><field name="name">ow.duplicate.group.list</field><field name="model">ow.duplicate.group</field><field name="arch" type="xml"><list create="0" decoration-muted="status == 'ignored'" decoration-success="status == 'merged'"><field name="name"/><field name="status" widget="badge" decoration-info="status == 'open'" decoration-success="status == 'merged'"/><field name="confidence" widget="progressbar"/><field name="member_count"/><field name="rule_id"/><field name="match_reason" optional="show"/><field name="scan_id" optional="hide"/><button name="action_open_merge_wizard" type="object" string="Review &amp; Merge" icon="fa-compress" class="btn-primary" invisible="status != 'open'"/><button name="action_ignore" type="object" string="Ignore" icon="fa-eye-slash" invisible="status != 'open'"/></list></field></record>
 <record id="view_duplicate_group_kanban" model="ir.ui.view"><field name="name">ow.duplicate.group.kanban</field><field name="model">ow.duplicate.group</field><field name="arch" type="xml"><kanban class="o_kanban_small_column ow_duplicate_kanban" default_group_by="status"><field name="status"/><field name="confidence"/><field name="member_count"/><field name="match_reason"/><field name="rule_id"/><templates><t t-name="card"><div class="ow_group_card"><div class="d-flex justify-content-between"><span class="ow_confidence"><t t-esc="Math.round(record.confidence.raw_value)"/>%</span><span class="badge text-bg-light"><field name="member_count"/> records</span></div><h4><field name="rule_id"/></h4><p><field name="match_reason"/></p><div class="d-flex gap-2 mt-3" t-if="record.status.raw_value === 'open'"><button name="action_open_merge_wizard" type="object" class="btn btn-primary btn-sm"><i class="fa fa-compress me-1"/>Review &amp; Merge</button><button name="action_ignore" type="object" class="btn btn-light btn-sm">Ignore</button></div></div></t></templates></kanban></field></record>
 <record id="view_duplicate_group_form" model="ir.ui.view"><field name="name">ow.duplicate.group.form</field><field name="model">ow.duplicate.group</field><field name="arch" type="xml"><form create="0" edit="0" class="ow_cleaner_form"><header><button name="action_open_merge_wizard" type="object" string="Review &amp; Merge" icon="fa-compress" class="btn-primary" invisible="status != 'open'" groups="ow_duplicate_data_cleaner.group_duplicate_manager"/><button name="action_ignore" type="object" string="Ignore" invisible="status != 'open'"/><button name="action_reopen" type="object" string="Reopen" invisible="status == 'open'"/><field name="status" widget="statusbar" statusbar_visible="open,merged,ignored"/></header><sheet><div class="ow_cleaner_hero"><div class="ow_cleaner_hero_icon"><i class="fa fa-clone" title="Duplicate group"/></div><div><h2><field name="name"/></h2><p><field name="match_reason"/></p></div></div><group><group><field name="rule_id"/><field name="scan_id"/><field name="model_name"/></group><group><field name="confidence" widget="percentage"/><field name="member_count"/><field name="merged_by" invisible="status != 'merged'"/><field name="merged_at" invisible="status != 'merged'"/></group></group><field name="member_ids"><list create="0" delete="0"><field name="is_suggested_master" widget="boolean_favorite" string="Suggested"/><field name="record_name"/><field name="completeness_score"/><field name="value_preview"/><field name="exists"/><button name="action_open_record" type="object" string="Open" icon="fa-external-link"/></list></field></sheet></form></field></record>
 <record id="view_duplicate_group_search" model="ir.ui.view"><field name="name">ow.duplicate.group.search</field><field name="model">ow.duplicate.group</field><field name="arch" type="xml"><search><field name="name"/><field name="rule_id"/><filter name="to_review" string="To Review" domain="[('status','=','open')]"/><filter name="high_confidence" string="90%+ confidence" domain="[('confidence','&gt;=',90)]"/><filter name="merged" string="Merged" domain="[('status','=','merged')]"/><group><filter name="group_status" string="Status" context="{'group_by':'status'}"/><filter name="group_rule" string="Rule" context="{'group_by':'rule_id'}"/></group></search></field></record>
 <record id="action_duplicate_group" model="ir.actions.act_window"><field name="name">Duplicate Review</field><field name="res_model">ow.duplicate.group</field><field name="view_mode">kanban,list,form</field><field name="search_view_id" ref="view_duplicate_group_search"/><field name="context">{'search_default_to_review': 1}</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Your data is clean</p><p>Run a rule to find and review duplicate record groups.</p></field></record>
</odoo>
