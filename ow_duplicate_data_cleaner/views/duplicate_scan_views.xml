<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_duplicate_scan_list" model="ir.ui.view"><field name="name">ow.duplicate.scan.list</field><field name="model">ow.duplicate.scan</field><field name="arch" type="xml"><list create="0" decoration-success="state == 'done'" decoration-danger="state == 'failed'"><field name="name"/><field name="state" widget="badge" decoration-success="state == 'done'" decoration-danger="state == 'failed'"/><field name="scanned_record_count"/><field name="compared_pair_count" optional="show"/><field name="duplicate_group_count"/><field name="duplicate_record_count"/><field name="duration"/><field name="started_at"/><button name="action_view_groups" type="object" string="Groups" icon="fa-clone"/></list></field></record>
 <record id="view_duplicate_scan_form" model="ir.ui.view"><field name="name">ow.duplicate.scan.form</field><field name="model">ow.duplicate.scan</field><field name="arch" type="xml"><form create="0" edit="0" class="ow_cleaner_form"><sheet><div class="oe_button_box" name="button_box"><button name="action_view_groups" type="object" class="oe_stat_button" icon="fa-clone"><field name="duplicate_group_count" widget="statinfo" string="Groups"/></button></div><div class="ow_cleaner_hero"><div class="ow_cleaner_hero_icon"><i class="fa fa-radar" title="Scan results"/></div><div><h2><field name="name" readonly="1"/></h2><p>Completed scan results and candidate groups ready for human review.</p></div></div><group><group><field name="rule_id"/><field name="model_name"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company"/></group><group><field name="started_at"/><field name="finished_at"/><field name="duration"/><field name="error_message" invisible="state != 'failed'"/></group></group><div class="ow_metric_grid"><div><strong><field name="scanned_record_count"/></strong><span>Records scanned</span></div><div><strong><field name="compared_pair_count"/></strong><span>Pairs compared</span></div><div><strong><field name="duplicate_group_count"/></strong><span>Groups found</span></div><div><strong><field name="duplicate_record_count"/></strong><span>Duplicate records</span></div></div><field name="group_ids"><list create="0" delete="0"><field name="name"/><field name="status" widget="badge"/><field name="confidence" widget="progressbar"/><field name="member_count"/><field name="match_reason"/><button name="action_open_merge_wizard" type="object" string="Review" icon="fa-eye" invisible="status != 'open'"/></list></field></sheet></form></field></record>
 <record id="action_duplicate_scan" model="ir.actions.act_window"><field name="name">Scan History</field><field name="res_model">ow.duplicate.scan</field><field name="view_mode">list,form</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">No scans yet</p><p>Open a detection rule and select Scan Now.</p></field></record>
</odoo>
