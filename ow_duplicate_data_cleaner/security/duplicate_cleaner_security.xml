<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_duplicate_cleaner" model="ir.module.category">
        <field name="name">Duplicate Data Cleaner</field>
        <field name="sequence">38</field>
    </record>
    <record id="privilege_duplicate_cleaner" model="res.groups.privilege">
        <field name="name">Duplicate Data Cleaner</field>
        <field name="category_id" ref="module_category_duplicate_cleaner"/>
        <field name="sequence">10</field>
    </record>
    <record id="group_duplicate_user" model="res.groups">
        <field name="name">Reviewer</field>
        <field name="privilege_id" ref="privilege_duplicate_cleaner"/>
    </record>
    <record id="group_duplicate_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_duplicate_cleaner"/>
        <field name="implied_ids" eval="[(4, ref('group_duplicate_user'))]"/>
    </record>

    <record id="rule_duplicate_rule_company" model="ir.rule">
        <field name="name">Duplicate rules by company</field><field name="model_id" ref="model_ow_duplicate_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_duplicate_user'))]"/>
    </record>
    <record id="rule_duplicate_scan_company" model="ir.rule">
        <field name="name">Duplicate scans by company</field><field name="model_id" ref="model_ow_duplicate_scan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_duplicate_user'))]"/>
    </record>
    <record id="rule_duplicate_group_company" model="ir.rule">
        <field name="name">Duplicate groups by company</field><field name="model_id" ref="model_ow_duplicate_group"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_duplicate_user'))]"/>
    </record>
    <record id="rule_duplicate_member_company" model="ir.rule">
        <field name="name">Duplicate members by company</field><field name="model_id" ref="model_ow_duplicate_member"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_duplicate_user'))]"/>
    </record>
    <record id="rule_duplicate_log_company" model="ir.rule">
        <field name="name">Duplicate merge logs by company</field><field name="model_id" ref="model_ow_duplicate_merge_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_duplicate_user'))]"/>
    </record>
</odoo>
