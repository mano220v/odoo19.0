<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_calculator_favorite_tree" model="ir.ui.view">
        <field name="name">calculator.favorite.list</field>
        <field name="model">calculator.favorite</field>
        <field name="arch" type="xml">
            <list string="Favorites" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="expression"/>
                <field name="user_id" optional="hide" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="action_calculator_favorite" model="ir.actions.act_window">
        <field name="name">Favorites</field>
        <field name="res_model">calculator.favorite</field>
        <field name="view_mode">list</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{'default_user_id': uid}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No favorites saved yet.
            </p>
            <p>
                Star an expression from any calculator to save it here for quick reuse.
            </p>
        </field>
    </record>

</odoo>
