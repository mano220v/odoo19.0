<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<!-- ═══════════════════════════════════════════════════════════════════════════
     MAIN WORD EDITOR ACTION TEMPLATE
══════════════════════════════════════════════════════════════════════════════ -->
<t t-name="word_editor.WordEditorAction">
  <div class="o_we_root">

    <!-- ── Top Navigation Bar ────────────────────────────────────────────── -->
    <div class="o_we_navbar">
      <div class="o_we_navbar_left">
        <button class="o_we_btn_back" t-on-click="goBack" title="Back to documents">
          <i class="fa fa-arrow-left"/>
        </button>
        <div class="o_we_app_brand">
          <i class="fa fa-file-text-o o_we_brand_icon"/>
          <span class="o_we_brand_name">Word Editor</span>
        </div>
        <div class="o_we_title_wrap">
          <input
            class="o_we_doc_title"
            type="text"
            t-ref="docTitle"
            t-att-value="state.title"
            t-on-input="onTitleInput"
            placeholder="Untitled Document"
          />
        </div>
        <div class="o_we_save_status" t-att-class="state.isDirty ? 'unsaved' : 'saved'">
          <i t-if="state.isSaving" class="fa fa-spinner fa-spin"/>
          <i t-elif="state.isDirty" class="fa fa-circle-o"/>
          <i t-else="" class="fa fa-check-circle"/>
          <span><t t-esc="saveStatusLabel"/></span>
        </div>
      </div>

      <div class="o_we_navbar_right">
        <button class="o_we_nav_btn o_we_nav_btn_secondary"
                t-on-click="openTemplates" title="Templates">
          <i class="fa fa-th-large"/> <span>Templates</span>
        </button>
        <button class="o_we_nav_btn o_we_nav_btn_secondary"
                t-on-click="exportDocx" title="Export as DOCX">
          <i class="fa fa-download"/> <span>DOCX</span>
        </button>
        <button class="o_we_nav_btn o_we_nav_btn_secondary"
                t-on-click="exportPdf" title="Export as PDF">
          <i class="fa fa-file-pdf-o"/> <span>PDF</span>
        </button>
        <button class="o_we_nav_btn o_we_nav_btn_secondary"
                t-on-click="printDocument" title="Print">
          <i class="fa fa-print"/> <span>Print</span>
        </button>
        <button class="o_we_nav_btn o_we_nav_btn_primary"
                t-on-click="saveDocument" title="Save (Ctrl+S)">
          <i class="fa fa-save"/> <span>Save</span>
        </button>
      </div>
    </div>

    <!-- ── Toolbar ───────────────────────────────────────────────────────── -->
    <div class="o_we_toolbar">

      <!-- Row 1 -->
      <div class="o_we_toolbar_row">

        <!-- Undo / Redo -->
        <button class="o_we_tb_btn" t-on-click="undo" title="Undo (Ctrl+Z)">
          <i class="fa fa-undo"/>
        </button>
        <button class="o_we_tb_btn" t-on-click="redo" title="Redo (Ctrl+Y)">
          <i class="fa fa-repeat"/>
        </button>
        <span class="o_we_tb_sep"/>

        <!-- Heading / Paragraph Style -->
        <select class="o_we_tb_select o_we_heading_select"
                title="Paragraph Style"
                t-on-change="onHeadingChange">
          <option value="p">Normal</option>
          <option value="h1">Heading 1</option>
          <option value="h2">Heading 2</option>
          <option value="h3">Heading 3</option>
          <option value="h4">Heading 4</option>
          <option value="h5">Heading 5</option>
          <option value="h6">Heading 6</option>
          <option value="blockquote">Blockquote</option>
          <option value="pre">Preformatted</option>
        </select>
        <span class="o_we_tb_sep"/>

        <!-- Font Family -->
        <select class="o_we_tb_select o_we_font_select"
                title="Font Family"
                t-on-change="onFontChange">
          <option value="Arial">Arial</option>
          <option value="Arial Black">Arial Black</option>
          <option value="Comic Sans MS">Comic Sans MS</option>
          <option value="Courier New">Courier New</option>
          <option value="Georgia">Georgia</option>
          <option value="Impact">Impact</option>
          <option value="Lucida Console">Lucida Console</option>
          <option value="Palatino Linotype">Palatino Linotype</option>
          <option value="Tahoma">Tahoma</option>
          <option value="Times New Roman">Times New Roman</option>
          <option value="Trebuchet MS">Trebuchet MS</option>
          <option value="Verdana">Verdana</option>
        </select>

        <!-- Font Size -->
        <select class="o_we_tb_select o_we_size_select"
                title="Font Size"
                t-on-change="onSizeChange">
          <option value="8">8</option>
          <option value="9">9</option>
          <option value="10">10</option>
          <option value="11">11</option>
          <option value="12" selected="selected">12</option>
          <option value="14">14</option>
          <option value="16">16</option>
          <option value="18">18</option>
          <option value="20">20</option>
          <option value="22">22</option>
          <option value="24">24</option>
          <option value="28">28</option>
          <option value="32">32</option>
          <option value="36">36</option>
          <option value="40">40</option>
          <option value="48">48</option>
          <option value="60">60</option>
          <option value="72">72</option>
        </select>
        <span class="o_we_tb_sep"/>

        <!-- Bold / Italic / Underline / Strike -->
        <button class="o_we_tb_btn o_we_fmt_btn"
                t-att-class="{ active: state.bold }"
                t-on-click="toggleBold" title="Bold (Ctrl+B)">
          <b>B</b>
        </button>
        <button class="o_we_tb_btn o_we_fmt_btn"
                t-att-class="{ active: state.italic }"
                t-on-click="toggleItalic" title="Italic (Ctrl+I)">
          <i>I</i>
        </button>
        <button class="o_we_tb_btn o_we_fmt_btn"
                t-att-class="{ active: state.underline }"
                t-on-click="toggleUnderline" title="Underline (Ctrl+U)">
          <u>U</u>
        </button>
        <button class="o_we_tb_btn o_we_fmt_btn"
                t-att-class="{ active: state.strike }"
                t-on-click="toggleStrike" title="Strikethrough">
          <s>S</s>
        </button>
        <button class="o_we_tb_btn o_we_fmt_btn" t-on-click="toggleSuperscript" title="Superscript">
          <span>x<sup style="font-size:0.7em">2</sup></span>
        </button>
        <button class="o_we_tb_btn o_we_fmt_btn" t-on-click="toggleSubscript" title="Subscript">
          <span>x<sub style="font-size:0.7em">2</sub></span>
        </button>
        <span class="o_we_tb_sep"/>

        <!-- Text Colour -->
        <div class="o_we_color_wrap" title="Text Color">
          <button class="o_we_tb_btn o_we_color_btn" t-on-click="openTextColorPicker">
            <span class="o_we_color_letter" t-att-style="'color:' + state.textColor">A</span>
            <span class="o_we_color_bar" t-att-style="'background:' + state.textColor"/>
          </button>
        </div>

        <!-- Highlight -->
        <div class="o_we_color_wrap" title="Highlight Color">
          <button class="o_we_tb_btn o_we_color_btn" t-on-click="openHiliteColorPicker">
            <span class="o_we_highlight_icon" t-att-style="'background:' + state.hiliteColor">H</span>
            <span class="o_we_color_bar" t-att-style="'background:' + state.hiliteColor"/>
          </button>
        </div>
        <span class="o_we_tb_sep"/>

        <!-- Clear Formatting -->
        <button class="o_we_tb_btn" t-on-click="clearFormat" title="Clear Formatting">
          <i class="fa fa-eraser"/>
        </button>

      </div>

      <!-- Row 2 -->
      <div class="o_we_toolbar_row">

        <!-- Alignment -->
        <button class="o_we_tb_btn" t-on-click="alignLeft" title="Align Left">
          <i class="fa fa-align-left"/>
        </button>
        <button class="o_we_tb_btn" t-on-click="alignCenter" title="Align Center">
          <i class="fa fa-align-center"/>
        </button>
        <button class="o_we_tb_btn" t-on-click="alignRight" title="Align Right">
          <i class="fa fa-align-right"/>
        </button>
        <button class="o_we_tb_btn" t-on-click="alignJustify" title="Justify">
          <i class="fa fa-align-justify"/>
        </button>
        <span class="o_we_tb_sep"/>

        <!-- Lists -->
        <button class="o_we_tb_btn" t-on-click="bulletList" title="Bullet List">
          <i class="fa fa-list-ul"/>
        </button>
        <button class="o_we_tb_btn" t-on-click="numberedList" title="Numbered List">
          <i class="fa fa-list-ol"/>
        </button>
        <button class="o_we_tb_btn" t-on-click="outdent" title="Decrease Indent">
          <i class="fa fa-outdent"/>
        </button>
        <button class="o_we_tb_btn" t-on-click="indent" title="Increase Indent">
          <i class="fa fa-indent"/>
        </button>
        <span class="o_we_tb_sep"/>

        <!-- Insert Table -->
        <button class="o_we_tb_btn" t-on-click="openTableModal" title="Insert Table">
          <i class="fa fa-table"/>
        </button>

        <!-- Insert Link -->
        <button class="o_we_tb_btn" t-on-click="openInsertLink" title="Insert Link (Ctrl+K)">
          <i class="fa fa-link"/>
        </button>

        <!-- Insert Image -->
        <button class="o_we_tb_btn" t-on-click="openInsertImage" title="Insert Image">
          <i class="fa fa-image"/>
        </button>

        <!-- Horizontal Rule -->
        <button class="o_we_tb_btn" t-on-click="insertHR" title="Horizontal Rule">
          <i class="fa fa-minus"/>
        </button>

        <!-- Page Break -->
        <button class="o_we_tb_btn" t-on-click="insertPageBreak" title="Page Break">
          <i class="fa fa-file-o"/>
          <span style="font-size:9px;vertical-align:middle">↵</span>
        </button>
        <span class="o_we_tb_sep"/>

        <!-- Find and Replace -->
        <button class="o_we_tb_btn"
                t-att-class="{ active: state.showFindReplace }"
                t-on-click="() => state.showFindReplace = !state.showFindReplace"
                title="Find &amp; Replace (Ctrl+F)">
          <i class="fa fa-search"/>
        </button>
        <span class="o_we_tb_sep"/>

        <!-- Zoom -->
        <div class="o_we_zoom_ctrl">
          <i class="fa fa-search-minus"/>
          <input type="range" min="50" max="200" step="10"
                 t-att-value="state.zoom"
                 t-on-input="onZoomChange"
                 class="o_we_zoom_slider" title="Zoom"/>
          <i class="fa fa-search-plus"/>
          <span class="o_we_zoom_label"><t t-esc="state.zoom"/>%</span>
        </div>

      </div>
    </div>

    <!-- ── Find and Replace Panel ─────────────────────────────────────────── -->
    <div t-if="state.showFindReplace" class="o_we_find_replace">
      <div class="o_we_fr_row">
        <label>Find:</label>
        <input type="text" class="o_we_fr_input"
               t-att-value="state.findText"
               t-on-input="onFindInput"
               placeholder="Search text…"/>
        <button class="btn btn-sm btn-primary" t-on-click="findNext">
          <i class="fa fa-chevron-down"/> Next
        </button>
      </div>
      <div class="o_we_fr_row">
        <label>Replace:</label>
        <input type="text" class="o_we_fr_input"
               t-att-value="state.replaceText"
               t-on-input="onReplaceInput"
               placeholder="Replace with…"/>
        <button class="btn btn-sm btn-secondary" t-on-click="replaceNext">Replace</button>
        <button class="btn btn-sm btn-warning"   t-on-click="replaceAll">Replace All</button>
        <button class="btn btn-sm btn-light"
                t-on-click="() => state.showFindReplace = false">
          <i class="fa fa-times"/>
        </button>
      </div>
    </div>

    <!-- ── Editor Area ────────────────────────────────────────────────────── -->
    <div class="o_we_editor_wrap">
      <div class="o_we_canvas"
           t-att-style="'transform: scale(' + state.zoom/100 + '); transform-origin: top center;'">

        <!-- Ruler -->
        <div class="o_we_ruler">
          <div class="o_we_ruler_inner">
            <span>1</span><span>2</span><span>3</span><span>4</span>
            <span>5</span><span>6</span><span>7</span><span>8</span>
            <span>9</span><span>10</span><span>11</span><span>12</span>
            <span>13</span><span>14</span><span>15</span><span>16</span>
          </div>
        </div>

        <!-- A4 Page -->
        <div class="o_we_page">
          <!-- Loading overlay -->
          <div t-if="state.isLoading" class="o_we_loading">
            <i class="fa fa-spinner fa-spin fa-2x"/>
            <p>Loading document…</p>
          </div>

          <!-- Editable area -->
          <div t-ref="editorArea"
               class="o_we_editor"
               contenteditable="true"
               spellcheck="true"
               t-att-style="state.isLoading ? 'display:none' : ''"
               data-placeholder="Start typing your document…">
          </div>
        </div>
      </div>
    </div>

    <!-- ── Status Bar ─────────────────────────────────────────────────────── -->
    <div class="o_we_statusbar">
      <div class="o_we_sb_left">
        <span class="o_we_sb_item">
          <i class="fa fa-font"/> Words: <strong><t t-esc="state.wordCount"/></strong>
        </span>
        <span class="o_we_sb_item">
          Chars: <strong><t t-esc="state.charCount"/></strong>
        </span>
        <span class="o_we_sb_item">
          <i class="fa fa-clock-o"/> ~<t t-esc="state.readingTime"/> min read
        </span>
      </div>
      <div class="o_we_sb_right">
        <span t-if="state.docId" class="o_we_sb_item o_we_doc_id">
          Doc #<t t-esc="state.docId"/>
        </span>
        <span class="o_we_sb_item">
          A4 · 12pt · <t t-esc="state.currentFont"/>
        </span>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════
         MODALS / OVERLAYS
    ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Colour Picker Overlay -->
    <t t-if="state.showColorPicker">
      <div class="o_we_overlay" t-on-click="() => state.showColorPicker = false"/>
      <div class="o_we_color_picker">
        <div class="o_we_cp_header">
          <t t-if="state.colorPickerType === 'text'">Text Colour</t>
          <t t-else="">Highlight Colour</t>
          <button class="o_we_cp_close" t-on-click="() => state.showColorPicker = false">✕</button>
        </div>
        <div class="o_we_cp_swatches">
          <div class="o_we_swatch"
               t-foreach="['#000000','#ffffff','#ff0000','#00aa00','#0000ff','#ffff00',
                           '#ff00ff','#00cccc','#ff8800','#8800cc','#00cc88','#ff0088',
                           '#1a365d','#2c5282','#4a90d9','#68d391','#f6ad55','#fc8181',
                           '#63b3ed','#b794f4','#f687b3','#4fd1c5','#fbd38d','#e2e8f0',
                           '#333333','#555555','#777777','#999999','#bbbbbb','#dddddd']"
               t-as="color"
               t-key="color"
               t-att-style="'background:' + color"
               t-att-title="color"
               t-on-click="() => this.applyColor(color)">
          </div>
        </div>
        <div class="o_we_cp_custom">
          <label>Custom:</label>
          <input type="color"
                 t-att-value="state.colorPickerType === 'text' ? state.textColor : state.hiliteColor"
                 t-on-change="(ev) => this.applyColor(ev.target.value)"/>
        </div>
      </div>
    </t>

    <!-- Insert Table Modal -->
    <t t-if="state.showTableModal">
      <div class="o_we_modal_backdrop" t-on-click="() => state.showTableModal = false"/>
      <div class="o_we_modal">
        <div class="o_we_modal_header">
          <i class="fa fa-table"/> Insert Table
          <button class="o_we_modal_close" t-on-click="() => state.showTableModal = false">✕</button>
        </div>
        <div class="o_we_modal_body">
          <div class="o_we_modal_field">
            <label>Rows:</label>
            <input type="number" min="1" max="50" class="o_we_modal_input"
                   t-att-value="state.tableRows"
                   t-on-input="onTableRows"/>
          </div>
          <div class="o_we_modal_field">
            <label>Columns:</label>
            <input type="number" min="1" max="20" class="o_we_modal_input"
                   t-att-value="state.tableCols"
                   t-on-input="onTableCols"/>
          </div>
          <!-- Visual grid picker -->
          <div class="o_we_table_grid">
            <t t-foreach="[1,2,3,4,5,6]" t-as="r" t-key="r">
              <div class="o_we_tg_row">
                <t t-foreach="[1,2,3,4,5,6]" t-as="c" t-key="c">
                  <div class="o_we_tg_cell"
                       t-att-class="r &lt;= state.tableRows &amp;&amp; c &lt;= state.tableCols ? 'selected' : ''"
                       t-on-mouseenter="() => { state.tableRows = r; state.tableCols = c; }"
                       t-on-click="insertTable"/>
                </t>
              </div>
            </t>
          </div>
          <p class="o_we_tg_label">
            <t t-esc="state.tableRows"/>×<t t-esc="state.tableCols"/>
          </p>
        </div>
        <div class="o_we_modal_footer">
          <button class="btn btn-secondary" t-on-click="() => state.showTableModal = false">Cancel</button>
          <button class="btn btn-primary"   t-on-click="insertTable">Insert Table</button>
        </div>
      </div>
    </t>

    <!-- Insert Link Modal -->
    <t t-if="state.showInsertLink">
      <div class="o_we_modal_backdrop" t-on-click="() => state.showInsertLink = false"/>
      <div class="o_we_modal">
        <div class="o_we_modal_header">
          <i class="fa fa-link"/> Insert Link
          <button class="o_we_modal_close" t-on-click="() => state.showInsertLink = false">✕</button>
        </div>
        <div class="o_we_modal_body">
          <div class="o_we_modal_field">
            <label>Display Text:</label>
            <input type="text" class="o_we_modal_input o_we_modal_input_full"
                   t-att-value="state.linkText"
                   t-on-input="onLinkTextInput"
                   placeholder="Link text…"/>
          </div>
          <div class="o_we_modal_field">
            <label>URL:</label>
            <input type="url" class="o_we_modal_input o_we_modal_input_full"
                   t-att-value="state.linkUrl"
                   t-on-input="onLinkUrlInput"
                   placeholder="https://…"/>
          </div>
        </div>
        <div class="o_we_modal_footer">
          <button class="btn btn-secondary" t-on-click="() => state.showInsertLink = false">Cancel</button>
          <button class="btn btn-primary"   t-on-click="confirmInsertLink">
            <i class="fa fa-link"/> Insert Link
          </button>
        </div>
      </div>
    </t>

    <!-- Insert Image Modal -->
    <t t-if="state.showInsertImage">
      <div class="o_we_modal_backdrop" t-on-click="() => state.showInsertImage = false"/>
      <div class="o_we_modal">
        <div class="o_we_modal_header">
          <i class="fa fa-image"/> Insert Image
          <button class="o_we_modal_close" t-on-click="() => state.showInsertImage = false">✕</button>
        </div>
        <div class="o_we_modal_body">
          <div class="o_we_modal_field">
            <label>Image URL:</label>
            <input type="url" class="o_we_modal_input o_we_modal_input_full"
                   t-att-value="state.imageUrl"
                   t-on-input="onImageUrlInput"
                   placeholder="https://example.com/image.png"/>
          </div>
          <t t-if="state.imageUrl">
            <div class="o_we_img_preview">
              <img t-att-src="state.imageUrl" alt="Preview"
                   style="max-width:100%;max-height:200px;border-radius:4px"/>
            </div>
          </t>
        </div>
        <div class="o_we_modal_footer">
          <button class="btn btn-secondary" t-on-click="() => state.showInsertImage = false">Cancel</button>
          <button class="btn btn-primary"   t-on-click="confirmInsertImage">
            <i class="fa fa-image"/> Insert Image
          </button>
        </div>
      </div>
    </t>

    <!-- Templates Panel -->
    <t t-if="state.showTemplates">
      <div class="o_we_modal_backdrop" t-on-click="() => state.showTemplates = false"/>
      <div class="o_we_modal o_we_templates_modal">
        <div class="o_we_modal_header">
          <i class="fa fa-th-large"/> Choose a Template
          <button class="o_we_modal_close" t-on-click="() => state.showTemplates = false">✕</button>
        </div>
        <div class="o_we_modal_body o_we_tpl_body">
          <t t-if="!state.templates.length">
            <p class="o_we_tpl_empty">No templates available.</p>
          </t>
          <div class="o_we_tpl_grid">
            <!-- Blank always shown first -->
            <div class="o_we_tpl_card o_we_tpl_blank" t-on-click="applyBlankTemplate">
              <div class="o_we_tpl_icon"><i class="fa fa-file-o fa-2x"/></div>
              <div class="o_we_tpl_info">
                <strong>Blank Document</strong>
                <span>Start from scratch</span>
              </div>
            </div>

            <t t-foreach="state.templates" t-as="tpl" t-key="tpl.id">
              <div class="o_we_tpl_card" t-on-click="() => this.applyTemplate(tpl)">
                <div class="o_we_tpl_icon" t-att-style="'color: #4a90d9'">
                  <i t-att-class="'fa ' + (tpl.icon || 'fa-file-text-o') + ' fa-2x'"/>
                </div>
                <div class="o_we_tpl_info">
                  <strong><t t-esc="tpl.name"/></strong>
                  <span class="o_we_tpl_cat"><t t-esc="tpl.category"/></span>
                  <span t-if="tpl.description" class="o_we_tpl_desc">
                    <t t-esc="tpl.description"/>
                  </span>
                </div>
              </div>
            </t>
          </div>
        </div>
      </div>
    </t>

  </div>
</t>

</templates>
