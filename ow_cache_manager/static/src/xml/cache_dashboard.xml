<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="ow_cache_manager.Dashboard" owl="1">
    <div class="o_tcm_dashboard">
      <div class="o_tcm_header">
        <h2>Cache &amp; Storage Manager</h2>
        <div class="o_tcm_actions">
          <button class="btn btn-primary" t-on-click="generate" t-att-disabled="state.loading">
            <t t-if="state.loading">Scanning...</t>
            <t t-else="">Generate</t>
          </button>
          <button class="btn btn-danger" t-on-click="clearAll"
                  t-att-disabled="state.clearing or !state.scanned">
            <t t-if="state.clearing">Clearing...</t>
            <t t-else="">Clear All Cache</t>
          </button>
        </div>
      </div>

      <div class="o_tcm_freed" t-if="state.last_freed_mb !== null">
        <i class="fa fa-check-circle"/> Freed <t t-esc="fmt(state.last_freed_mb)"/>
        across <t t-esc="state.last_cleared_count"/> file(s)
      </div>

      <div class="o_tcm_summary" t-if="state.scanned">
        <div class="o_tcm_card o_tcm_total">
          <span class="o_tcm_label">Total Storage Scanned</span>
          <span class="o_tcm_value" t-esc="fmt(state.total_mb)"/>
        </div>

        <div class="o_tcm_card">
          <span class="o_tcm_label">Asset Cache (regenerable)</span>
          <span class="o_tcm_value" t-esc="fmt(state.asset_cache_mb)"/>
          <span class="o_tcm_sub" t-esc="state.asset_count + ' files'"/>
          <button class="btn btn-sm btn-outline-danger" t-on-click="clearAssets"
                  t-att-disabled="state.clearing">Clear</button>
        </div>

        <div class="o_tcm_card">
          <span class="o_tcm_label">Orphaned Junk Files</span>
          <span class="o_tcm_value" t-esc="fmt(state.orphaned_mb)"/>
          <span class="o_tcm_sub" t-esc="state.orphaned_count + ' files'"/>
          <button class="btn btn-sm btn-outline-danger" t-on-click="clearOrphaned"
                  t-att-disabled="state.clearing">Clear</button>
        </div>
      </div>

      <div class="o_tcm_breakdown" t-if="state.scanned">
        <h3>Storage by Content Type <small class="text-muted">(click a row to view files)</small></h3>

        <div class="o_tcm_row" t-on-click="() => this.openCategory('image')">
          <span class="o_tcm_row_label"><i class="fa fa-file-image-o"/> Images</span>
          <div class="o_tcm_bar_wrap">
            <div class="o_tcm_bar o_tcm_bar_image" t-attf-style="width: #{barWidth(state.image_mb)}"/>
          </div>
          <span class="o_tcm_row_value" t-esc="fmt(state.image_mb)"/>
        </div>

        <div class="o_tcm_row" t-on-click="() => this.openCategory('video')">
          <span class="o_tcm_row_label"><i class="fa fa-file-video-o"/> Videos</span>
          <div class="o_tcm_bar_wrap">
            <div class="o_tcm_bar o_tcm_bar_video" t-attf-style="width: #{barWidth(state.video_mb)}"/>
          </div>
          <span class="o_tcm_row_value" t-esc="fmt(state.video_mb)"/>
        </div>

        <div class="o_tcm_row" t-on-click="() => this.openCategory('document')">
          <span class="o_tcm_row_label"><i class="fa fa-file-text-o"/> Documents</span>
          <div class="o_tcm_bar_wrap">
            <div class="o_tcm_bar o_tcm_bar_document" t-attf-style="width: #{barWidth(state.document_mb)}"/>
          </div>
          <span class="o_tcm_row_value" t-esc="fmt(state.document_mb)"/>
        </div>

        <div class="o_tcm_row" t-on-click="() => this.openCategory('audio')">
          <span class="o_tcm_row_label"><i class="fa fa-file-audio-o"/> Audio</span>
          <div class="o_tcm_bar_wrap">
            <div class="o_tcm_bar o_tcm_bar_audio" t-attf-style="width: #{barWidth(state.audio_mb)}"/>
          </div>
          <span class="o_tcm_row_value" t-esc="fmt(state.audio_mb)"/>
        </div>

        <div class="o_tcm_row" t-on-click="() => this.openCategory('other')">
          <span class="o_tcm_row_label"><i class="fa fa-file-o"/> Other</span>
          <div class="o_tcm_bar_wrap">
            <div class="o_tcm_bar o_tcm_bar_other" t-attf-style="width: #{barWidth(state.other_mb)}"/>
          </div>
          <span class="o_tcm_row_value" t-esc="fmt(state.other_mb)"/>
        </div>
      </div>
    </div>
  </t>
</templates>
