<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="ow_gmail_inbox.Workspace">
    <div class="og-app">
        <header class="og-topbar">
            <div class="og-brand"><span class="og-logo"><i class="fa fa-envelope-o" aria-hidden="true"/></span><div><strong>Gmail Inbox</strong><small>ODOO WINGS WORKSPACE</small></div></div>
            <form t-if="state.connected" class="og-search" t-on-submit.prevent="search"><i class="fa fa-search" aria-hidden="true"/><input aria-label="Search Gmail" t-model="state.query" placeholder="Search mail · from: · subject: · has:attachment" maxlength="1000"/><button type="submit" t-att-disabled="state.loading">Search</button></form>
            <div t-if="state.connected" class="og-account"><span class="og-account-dot"/><span t-esc="state.email"/><details><summary aria-label="Account options"><i class="fa fa-ellipsis-v" aria-hidden="true"/></summary><div class="og-account-menu"><button type="button" t-on-click="connect">Reconnect Google</button><button type="button" t-if="state.admin" t-on-click="settings">Google configuration</button><button type="button" t-on-click="() => this.disconnect(false)">Disconnect locally</button><button type="button" t-on-click="() => this.disconnect(true)">Revoke Google access</button></div></details></div>
        </header>
        <div t-if="state.error" class="og-error" role="alert"><i class="fa fa-exclamation-circle" aria-hidden="true"/><span t-esc="state.error"/><button type="button" aria-label="Dismiss error" t-on-click="() => state.error = ''"><i class="fa fa-times" aria-hidden="true"/></button></div>
        <div t-if="state.initializing" class="og-loading" role="status"><i class="fa fa-circle-o-notch fa-spin" aria-hidden="true"/> Opening your workspace…</div>
        <main t-elif="!state.connected" class="og-onboarding">
            <div class="og-welcome-art" aria-hidden="true"><div class="og-art-ring"/><div class="og-art-envelope"><i class="fa fa-envelope-o"/></div><span class="og-art-tag"><i class="fa fa-check"/> Connected work</span></div>
            <span class="og-eyebrow">YOUR MAIL. YOUR WORKSPACE.</span><h1>Gmail, right where<br/>you work.</h1><p>Read conversations, reply to customers and send messages without leaving your Odoo workspace.</p>
            <button type="button" class="og-connect" t-att-disabled="!state.configured" t-on-click="connect"><i class="fa fa-google" aria-hidden="true"/> Choose a Google account</button>
            <p class="og-auth-note"><strong>Google will show the accounts signed in to this browser.</strong><br/>Choose which Gmail mailbox to connect, authorize it on Google, and return here. Your Gmail password is never entered in Odoo.</p>
            <div t-if="!state.configured" class="og-setup-note"><strong>One-time setup needed</strong><span>Ask your administrator to add a Google OAuth client in Gmail Inbox → Configuration.</span><button t-if="state.admin" type="button" t-on-click="settings">Open configuration <i class="fa fa-arrow-right" aria-hidden="true"/></button></div>
            <div class="og-feature-row"><span><i class="fa fa-search" aria-hidden="true"/> Gmail search</span><span><i class="fa fa-paperclip" aria-hidden="true"/> Attachments</span><span><i class="fa fa-lock" aria-hidden="true"/> Personal connection</span></div>
        </main>
        <main t-else="" t-att-class="'og-workspace ' + (state.selected || state.composing || state.reading ? 'og-show-reader' : '')">
            <aside t-att-class="'og-sidebar ' + (state.mobileNav ? 'is-open' : '')">
                <button type="button" class="og-compose-button" t-on-click="() => this.compose()"><i class="fa fa-pencil" aria-hidden="true"/> Compose</button>
                <span class="og-sidebar-caption">MY MAILBOX</span>
                <nav aria-label="Gmail folders"><button t-foreach="folders" t-as="folder" t-key="folder.id" type="button" t-att-class="state.folder === folder.id ? 'is-active' : ''" t-att-aria-current="state.folder === folder.id ? 'page' : undefined" t-on-click="() => this.folder(folder.id)"><i t-att-class="'fa ' + folder.icon" aria-hidden="true"/><span t-esc="folder.label"/></button></nav>
                <div class="og-sidebar-note"><i class="fa fa-cloud" aria-hidden="true"/><strong>Connected to Gmail</strong><p>Mailbox actions update your Google account. Refresh to check for new mail.</p></div>
            </aside>
            <section class="og-message-list" aria-label="Message list" t-att-aria-busy="state.loading">
                <div class="og-list-heading"><button type="button" class="og-mobile-menu og-icon-button" aria-label="Toggle folders" t-on-click="() => state.mobileNav = !state.mobileNav"><i class="fa fa-bars" aria-hidden="true"/></button><div><h2 t-esc="folderName"/><small t-if="state.appliedQuery">Search results</small><small t-else="">Your latest conversations</small></div><button type="button" class="og-icon-button" title="Refresh mailbox" aria-label="Refresh mailbox" t-att-disabled="state.loading" t-on-click="refresh"><i t-att-class="'fa fa-refresh ' + (state.loading ? 'fa-spin' : '')" aria-hidden="true"/></button></div>
                <div class="og-message-scroll">
                    <div t-if="state.loading" class="og-loading" role="status"><i class="fa fa-circle-o-notch fa-spin" aria-hidden="true"/> Loading mail…</div>
                    <div t-elif="!state.messages.length" class="og-empty-list"><i class="fa fa-inbox" aria-hidden="true"/><strong>No messages to show</strong><span t-if="state.error">Resolve the error above, then refresh.</span><span t-else="">Try another folder or search.</span></div>
                    <article t-foreach="state.messages" t-as="message" t-key="message.id" t-att-class="'og-message-row ' + (message.unread ? 'is-unread ' : '') + (state.selected?.id === message.id ? 'is-selected' : '')">
                        <button type="button" class="og-message-open" t-on-click="() => this.read(message)"><div class="og-message-sender"><strong t-esc="this.sender(message.sender)"/><span t-if="message.unread" class="og-unread-dot" aria-label="Unread"/></div><span class="og-message-subject" t-esc="message.subject"/><p t-esc="message.snippet"/><time t-esc="message.date"/></button>
                        <button type="button" t-att-class="'og-star ' + (message.starred ? 'is-starred' : '')" t-att-aria-label="message.starred ? 'Remove star' : 'Star message'" t-att-disabled="state.mutating" t-on-click="() => this.modify(message, message.starred ? 'unstar' : 'star')"><i t-att-class="'fa ' + (message.starred ? 'fa-star' : 'fa-star-o')" aria-hidden="true"/></button>
                    </article>
                </div>
                <div class="og-pagination"><button type="button" aria-label="Previous page" t-att-disabled="state.loading || !state.previous.length" t-on-click="previous"><i class="fa fa-angle-left" aria-hidden="true"/></button><span>Page <t t-esc="pageNumber"/></span><button type="button" aria-label="Next page" t-att-disabled="state.loading || !state.nextPage" t-on-click="next"><i class="fa fa-angle-right" aria-hidden="true"/></button></div>
            </section>
            <section t-att-class="'og-reader ' + (state.composing ? 'is-composing' : state.selected ? 'has-message' : 'is-empty')" aria-label="Message reader">
                <t t-if="state.composing">
                    <form class="og-compose-form" t-on-submit.prevent="send">
                        <div class="og-reader-toolbar"><div><span class="og-eyebrow">FROM YOUR GMAIL ACCOUNT</span><h2 t-esc="state.draft.reply_id ? 'Reply' : 'New message'"/></div><button type="button" class="og-icon-button" aria-label="Close composer" t-att-disabled="state.sending || state.uploading" t-on-click="closeCompose"><i class="fa fa-times" aria-hidden="true"/></button></div>
                        <fieldset t-att-disabled="state.sending || state.uploading" class="og-compose-fields"><label><span>To</span><input required="required" t-model="state.draft.to" placeholder="name@example.com" maxlength="8000"/></label><div class="og-address-pair"><label><span>Cc</span><input t-model="state.draft.cc" placeholder="Optional" maxlength="8000"/></label><label><span>Bcc</span><input t-model="state.draft.bcc" placeholder="Optional" maxlength="8000"/></label></div><label><span>Subject</span><input t-model="state.draft.subject" placeholder="What is this about?" maxlength="998"/></label><label class="og-body-label"><span class="visually-hidden">Message body</span><textarea t-model="state.draft.body" placeholder="Write your message…" maxlength="200000"/></label></fieldset>
                        <div t-if="state.draft.attachments.length" class="og-compose-attachments"><div t-foreach="state.draft.attachments" t-as="file" t-key="file_index"><i class="fa fa-paperclip" aria-hidden="true"/><span t-esc="file.name"/><small t-esc="this.size(file.size)"/><button type="button" t-att-disabled="state.sending || state.uploading" t-att-aria-label="'Remove ' + file.name" t-on-click="() => this.removeAttachment(file_index)"><i class="fa fa-times" aria-hidden="true"/></button></div></div>
                        <div class="og-compose-footer"><button type="submit" class="og-primary" t-att-disabled="state.sending || state.uploading"><i t-att-class="'fa ' + (state.sending ? 'fa-circle-o-notch fa-spin' : 'fa-paper-plane')" aria-hidden="true"/><t t-if="state.sending"> Sending…</t><t t-else=""> Send email</t></button><label class="og-attach-control"><i class="fa fa-paperclip" aria-hidden="true"/> Attach files<input type="file" multiple="multiple" t-att-disabled="state.sending || state.uploading" t-on-change="attach"/></label><span t-if="state.uploading" role="status">Reading files…</span><small t-else="">10 files · 10 MB total</small></div>
                        <p class="og-compose-note">Plain-text message · Unsent content stays in this open workspace only.</p>
                    </form>
                </t>
                <div t-elif="state.reading &amp;&amp; !state.selected" class="og-loading" role="status"><i class="fa fa-circle-o-notch fa-spin" aria-hidden="true"/> Opening message…</div>
                <t t-elif="state.selected">
                    <div class="og-reader-toolbar"><button type="button" class="og-icon-button" title="Back to list" aria-label="Back to list" t-on-click="back"><i class="fa fa-arrow-left" aria-hidden="true"/></button><div class="og-mail-actions"><button type="button" title="Archive message" aria-label="Archive message" t-att-disabled="state.mutating || state.reading" t-on-click="() => this.modify(state.selected, 'archive')"><i class="fa fa-archive" aria-hidden="true"/></button><button type="button" t-att-title="state.selected.unread ? 'Mark as read' : 'Mark as unread'" t-att-aria-label="state.selected.unread ? 'Mark as read' : 'Mark as unread'" t-att-disabled="state.mutating || state.reading" t-on-click="() => this.modify(state.selected, state.selected.unread ? 'read' : 'unread')"><i class="fa fa-envelope-o" aria-hidden="true"/></button><button type="button" title="Move to Inbox" aria-label="Move to Inbox" t-att-disabled="state.mutating || state.reading || state.selected.trashed" t-on-click="() => this.modify(state.selected, 'inbox')"><i class="fa fa-inbox" aria-hidden="true"/></button><button type="button" t-att-title="state.selected.trashed ? 'Restore from Trash' : 'Move to Trash'" t-att-aria-label="state.selected.trashed ? 'Restore from Trash' : 'Move to Trash'" t-att-disabled="state.mutating || state.reading" t-on-click="() => this.modify(state.selected, state.selected.trashed ? 'untrash' : 'trash')"><i t-att-class="'fa ' + (state.selected.trashed ? 'fa-undo' : 'fa-trash-o')" aria-hidden="true"/></button></div><span class="og-reader-note">GMAIL MESSAGE</span></div>
                    <div class="og-mail-content"><article class="og-mail-sheet"><h1 t-esc="state.selected.subject || '(No subject)'"/><div class="og-message-meta"><span class="og-sender-avatar" t-esc="this.sender(state.selected.sender).slice(0, 1).toUpperCase() || '?'"/><div><strong t-esc="state.selected.sender || 'Unknown sender'"/><small>To: <t t-esc="state.selected.to || 'Undisclosed recipients'"/></small><small t-if="state.selected.cc">Cc: <t t-esc="state.selected.cc"/></small><time t-esc="state.selected.date"/></div></div><div class="og-mail-body" t-esc="this.messageBody(state.selected)"/>
                    <div t-if="state.selected.attachments &amp;&amp; state.selected.attachments.length" class="og-received-attachments"><h3><i class="fa fa-paperclip" aria-hidden="true"/> Attachments</h3><a t-foreach="state.selected.attachments" t-as="part" t-key="part.part_id" t-att-href="this.attachmentUrl(state.selected, part)" target="_blank" rel="noopener noreferrer"><i class="fa fa-file-o" aria-hidden="true"/><span><strong t-esc="part.name"/><small t-esc="this.size(part.size)"/></span><i class="fa fa-download" aria-hidden="true"/></a></div>
                    <button type="button" class="og-reply" t-att-disabled="state.reading" t-on-click="() => this.compose(state.selected)"><i class="fa fa-reply" aria-hidden="true"/> Reply</button><p class="og-safe-reader">Text reading view · External images and active email content are not loaded.</p></article></div>
                </t>
                <div t-else="" class="og-reader-empty"><div class="og-empty-art"><i class="fa fa-envelope-open-o" aria-hidden="true"/></div><span class="og-eyebrow">A LITTLE SPACE TO FOCUS</span><h2>Your next conversation<br/>starts here.</h2><p>Select a message to read it, or compose something new.</p><button type="button" class="og-primary" t-on-click="() => this.compose()"><i class="fa fa-pencil" aria-hidden="true"/> Write a message</button></div>
            </section>
        </main>
    </div>
</t>
</templates>
