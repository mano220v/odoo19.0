<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
	
	<record model="res.groups.privilege" id="res_groups_privilege_status_history">
		<field name="name">Field Tracker History</field>
	    </record>
    
        <!-- ── History User ─────────────────────────────────────────────── -->
        <record id="group_history_user" model="res.groups">
            <field name="name">History User</field>
             <field name="privilege_id" ref="res_groups_privilege_status_history"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                Can view the Change History tab on Purchase Orders, Sales Orders
                and Stock Pickings, and the Change History menu items inside each
                application.
            </field>
        </record>

        <!-- ── History Manager ──────────────────────────────────────────── -->
        <record id="group_history_manager" model="res.groups">
            <field name="name">History Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_status_history"/>
            <field name="implied_ids" eval="[(4, ref('group_history_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">
                Full access to all change history records, including the global
                All Change History menu and write/delete permissions on log
                entries. Typically assigned to managers and auditors.
            </field>
        </record>

    </data>
</odoo>
