<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ow_download_history" model="ir.module.category">
        <field name="name">Download History</field>
        <field name="description">Manage access to the Download History Manager module.</field>
        <field name="sequence">25</field>
    </record>

    <!-- Odoo 19: res.groups no longer has category_id directly — groups are
         attached to a res.groups.privilege, which in turn points at the
         ir.module.category. -->
    <record id="privilege_ow_download_history" model="res.groups.privilege">
        <field name="name">Download History</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="module_category_ow_download_history"/>
    </record>

    <record id="group_ow_download_history_user" model="res.groups">
        <field name="name">User: View Own Downloads</field>
        <field name="privilege_id" ref="privilege_ow_download_history"/>
        <field name="comment">Can see their own download history only.</field>
    </record>

    <record id="group_ow_download_history_manager" model="res.groups">
        <field name="name">Manager: Full Access</field>
        <field name="privilege_id" ref="privilege_ow_download_history"/>
        <field name="implied_ids" eval="[(4, ref('group_ow_download_history_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Can see every user's download history, configure retention and clear old records.</field>
    </record>

    <!-- Regular users: see only their own downloads -->
    <record id="rule_ow_download_history_own" model="ir.rule">
        <field name="name">Download History: users see only their own downloads</field>
        <field name="model_id" ref="model_ow_download_history"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_ow_download_history_user'))]"/>
    </record>

    <!-- Managers: see everything -->
    <record id="rule_ow_download_history_all" model="ir.rule">
        <field name="name">Download History: managers see all downloads</field>
        <field name="model_id" ref="model_ow_download_history"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ow_download_history_manager'))]"/>
    </record>
</odoo>
